# Server Configuration
PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=https://keynesfariz.github.io,http://localhost:3000
SESSION_TTL_SECONDS=300
BOT_NAME=Farsisstant
OWNER_NAME=Fariz

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_SECONDS=604800
RATE_LIMIT_MAX_QUERIES=30

# Redis Configuration (Upstash)
REDIS_URL=rediss://default:your-password@your-upstash-url:6379

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=keynesfariz-rag

# LLM API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
XAI_API_KEY=your-xai-api-key

# Embeddings
# If using Jina AI for embeddings
JINA_API_KEY=your-jina-api-key

# GitHub Webhook Secret
GITHUB_WEBHOOK_SECRET=your-webhook-secret
